{
  "name": "@floorcraft/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "worker:dev": "wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "db:migrate:local": "wrangler d1 execute floorcraft --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute floorcraft --remote --file=./schema.sql",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@floorcraft/core": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "@playwright/test": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wrangler": "^3.83.0"
  }
}
